/**
 * The drawn-art library, automated: find the parts a series is missing, register new packs,
 * and gate every art before a lesson may use it.
 *
 *   node scripts/art.mts register                     regenerate src/art/{packs,catalog}.gen.ts from
 *                                                     src/art/packs/<pack>.tsx + <pack>.catalog.ts
 *   node scripts/art.mts gaps <project>               parts in projects/<p>/visuals.json (and arts used
 *                                                     by its specs) that the catalogue lacks; exit 1 if any
 *   node scripts/art.mts check <art…> | --pack <p>    the art gates + a gallery sheet per art; exit 1 on failure
 *                                                     (a draft pack is bundled in isolation)
 *   node scripts/art.mts approve <pack>               gates + reviewer PASS → the draft joins the library
 *     [--data '{"name":"salt"}']                      (data for data-driven arts)
 *
 * Gates (each art alone on a white plate, src/templates/ArtProbe.tsx):
 *   registered   in the renderer (ARTS) and the catalogue, same anchor names both sides, anchors
 *                inside the drawing
 *   no text      no SVG <text> (lint-art); words belong to labels, so arts work in every language
 *   draws on     the drawing builds itself (little ink at the first frames)
 *   fills        the drawing uses its box (not a speck in a corner) and isn't cut off at its edges
 *   colour       house style is colourful flat forms, not grey line-art
 *   deterministic the same frame renders identically twice
 *   events       every catalogue `events` anchor visibly changes the picture when acted
 * The gallery (iterations/artlab/<art>.png + .txt legend) is what the art-reviewer agent judges:
 * recognisable, correct, in the house idiom, events legible.
 */
import {existsSync, mkdirSync, readFileSync, readdirSync, renameSync, statSync, writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {spawnSync} from 'node:child_process';
import {Jimp} from 'jimp';
import {selectComposition} from '@remotion/renderer';
import {ROOT, specIds, readSpec} from './lib/paths.mts';
import {closeBrowser, serve, serveWith, still} from './lib/remotion.mts';

const PACKS = join(ROOT, 'src', 'art', 'packs');
const OUT = join(ROOT, 'iterations', 'artlab');

/* ------------------------------------------------------------------ register */
const approved = () =>
  readdirSync(PACKS)
    .filter((f) => f.endsWith('.catalog.ts'))
    .map((f) => f.replace(/\.catalog\.ts$/, ''))
    .filter((p) => existsSync(join(PACKS, `${p}.tsx`)))
    .sort();
const drafts = () => readdirSync(PACKS).filter((f) => f.endsWith('.catalog.draft.ts')).map((f) => f.replace(/\.catalog\.draft\.ts$/, '')).sort();
const packsGen = (packs: string[], from: string) =>
  [
    '// generated by scripts/art.mts register — do not edit. Arts of approved generated packs.',
    `import type {ArtFactory} from '${from}/kit';`,
    ...packs.map((p, i) => `import a${i} from '${from}/packs/${p}';`),
    `export const GENERATED_ARTS: Record<string, ArtFactory> = {${packs.map((_, i) => `...a${i}`).join(', ')}};`,
    '',
  ].join('\n');

/** The library's registries: approved packs only (a draft enters through `approve`). */
export function register() {
  const packs = approved();
  writeFileSync(
    join(ROOT, 'src', 'art', 'catalog.gen.ts'),
    [
      '// generated by scripts/art.mts register — do not edit. Catalogue entries of approved generated packs.',
      "import type {PartMeta} from './catalog.ts';",
      ...packs.map((p, i) => `import c${i} from './packs/${p}.catalog.ts';`),
      `export const GENERATED: Record<string, PartMeta> = {${packs.map((_, i) => `...c${i}`).join(', ')}};`,
      '',
    ].join('\n'),
  );
  writeFileSync(join(ROOT, 'src', 'art', 'packs.gen.ts'), packsGen(packs, '.'));
  return packs;
}

/* ------------------------------------------------------------------ gaps */
type Part = {name: string; pack?: string; what?: string; anchors?: string[]; events?: string[]; accuracy?: string; usedBy?: string[]};
export async function gaps(project: string) {
  const {CATALOG} = await import('../src/art/catalog.ts');
  const file = join(ROOT, 'projects', project, 'visuals.json');
  const parts: Part[] = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')).parts ?? [] : [];
  // arts named by specs but not planned count too
  for (const id of specIds(project)) {
    const arts = new Set<string>();
    for (const s of readSpec(project, id).scenes as any[]) {
      if (s.art) arts.add(s.art);
      for (const l of s.world?.layers ?? []) arts.add(l.art);
      for (const b of s.beats ?? []) if (b.inset?.art) arts.add(b.inset.art);
      if (s.visual?.art) arts.add(s.visual.art);
    }
    for (const a of arts) if (!parts.some((p) => p.name === a)) parts.push({name: a, usedBy: [id]});
  }
  const missing = parts.filter((p) => !CATALOG[p.name]);
  const have = parts.filter((p) => CATALOG[p.name]);
  // a reused part the plan needs more from (an anchor or event it doesn't have) must be extended
  const name = (x: string) => x.split(/\s+[—–-]\s+/)[0].trim();
  const short = have
    .map((p) => {
      const anchors = CATALOG[p.name].anchors({});
      const need = [...(p.anchors ?? []), ...(p.events ?? [])].map(name).filter((a) => !anchors.includes(a));
      return {p, need};
    })
    .filter((x) => x.need.length);
  console.log(`${project}: ${parts.length} part(s) planned — ${have.length} in the library, ${missing.length} missing`);
  const drafted = new Set(drafts());
  for (const p of missing) console.log(`  ✗ ${p.name}${p.pack ? ` (pack ${p.pack}${p.pack && drafted.has(p.pack) ? ', draft awaiting approval' : ''})` : ''}${p.what ? ` — ${p.what}` : ''}`);
  for (const {p, need} of short) console.log(`  ✗ ${p.name} needs ${need.join(', ')} — extend the existing part (its pack's art-author adds anchors/events)`);
  if (!existsSync(file)) console.log(`  (no projects/${project}/visuals.json yet — the series-planner writes it)`);
  return [...missing, ...short.map((x) => x.p)];
}

/* ------------------------------------------------------------------ check */
type Img = Awaited<ReturnType<typeof Jimp.read>>;
type Box = {x: number; y: number; w: number; h: number};
const isInk = (img: Img, x: number, y: number) => {
  const c = img.getPixelColor(x, y);
  const r = (c >>> 24) & 255;
  const g = (c >>> 16) & 255;
  const b = (c >>> 8) & 255;
  return 765 - (r + g + b) > 36;
};
const sat = (img: Img, x: number, y: number) => {
  const c = img.getPixelColor(x, y);
  const r = (c >>> 24) & 255;
  const g = (c >>> 16) & 255;
  const b = (c >>> 8) & 255;
  const mx = Math.max(r, g, b);
  const mn = Math.min(r, g, b);
  return mx ? (mx - mn) / mx : 0;
};
/** Ink fraction, saturated share of the ink, and the ink's bounding box inside `box` (sampled every 2 px). */
function measure(img: Img, box: Box) {
  let ink = 0;
  let n = 0;
  let colour = 0;
  let [x0, y0, x1, y1] = [Infinity, Infinity, -Infinity, -Infinity];
  for (let y = Math.ceil(box.y); y < box.y + box.h; y += 2)
    for (let x = Math.ceil(box.x); x < box.x + box.w; x += 2) {
      n++;
      if (!isInk(img, x, y)) continue;
      ink++;
      if (sat(img, x, y) > 0.1) colour++;
      x0 = Math.min(x0, x);
      y0 = Math.min(y0, y);
      x1 = Math.max(x1, x);
      y1 = Math.max(y1, y);
    }
  return {ink: ink / n, colour: ink ? colour / ink : 0, bbox: ink ? {x: x0, y: y0, w: x1 - x0, h: y1 - y0} : null};
}
/** Share of the box's border (3 px inside) covered by ink: a drawing cut off at its edge. */
function edgeInk(img: Img, box: Box) {
  let hit = 0;
  let n = 0;
  const xs = [Math.ceil(box.x) + 3, Math.floor(box.x + box.w) - 4];
  const ys = [Math.ceil(box.y) + 3, Math.floor(box.y + box.h) - 4];
  for (const y of ys) for (let x = xs[0]; x <= xs[1]; x += 3) (n++, isInk(img, x, y) && hit++);
  for (const x of xs) for (let y = ys[0]; y <= ys[1]; y += 3) (n++, isInk(img, x, y) && hit++);
  return hit / n;
}
/** Share of pixels in `box` that differ clearly between two renders. */
function changed(a: Img, b: Img, box: Box) {
  let d = 0;
  let n = 0;
  for (let y = Math.ceil(box.y); y < box.y + box.h; y += 2)
    for (let x = Math.ceil(box.x); x < box.x + box.w; x += 2) {
      n++;
      const ca = a.getPixelColor(x, y);
      const cb = b.getPixelColor(x, y);
      if (ca === cb) continue;
      const dd = Math.abs(((ca >>> 24) & 255) - ((cb >>> 24) & 255)) + Math.abs(((ca >>> 16) & 255) - ((cb >>> 16) & 255)) + Math.abs(((ca >>> 8) & 255) - ((cb >>> 8) & 255));
      if (dd > 45) d++;
    }
  return d / n;
}

const T = {settled: 150, eventAt: 40, late: 260};
export const LIMITS = {drawOn: 0.4, minSpan: 0.6, minInk: 0.03, maxEdge: 0.22, minColour: 0.2, minEvent: 0.004};

export async function check(names: string[], data?: Record<string, unknown>, draft?: string) {
  const {CATALOG, entryOf} = await import('../src/art/catalog.ts');
  mkdirSync(OUT, {recursive: true});
  const lint = spawnSync('node', ['scripts/lint-art.mts'], {cwd: ROOT, encoding: 'utf8'});
  let serveUrl: string;
  if (draft) {
    // a draft pack is bundled on its own (approved packs + this draft), never via the shared registries
    const meta = (await import(`../src/art/packs/${draft}.catalog.draft.ts`)).default;
    for (const [n, m] of Object.entries(meta)) CATALOG[n] = entryOf(m as any);
    const gen = join(OUT, '_gen', `${draft}.packs.gen.ts`);
    mkdirSync(join(OUT, '_gen'), {recursive: true});
    writeFileSync(gen, packsGen([...approved().filter((p) => p !== draft), draft], join(ROOT, 'src', 'art')));
    serveUrl = await serveWith({[join(ROOT, 'src', 'art', 'packs.gen.ts')]: gen, [join(ROOT, 'src', 'art', 'packs.gen')]: gen});
  } else serveUrl = await serve();
  let failed = 0;
  for (const name of names) {
    const problems: string[] = [];
    const notes: string[] = [];
    const entry = CATALOG[name];
    if (!entry) problems.push(`not in the catalogue (src/art/catalog.ts or a packs/<pack>.catalog.ts)`);
    if (lint.status !== 0) problems.push(`SVG text found: ${lint.stdout.trim().split('\n').slice(-3).join(' ')}`);
    const d = data ?? (name === 'icon' ? {name: 'salt'} : {});
    const shot = async (tag: string, frame: number, events: Record<string, number> = {}, showAnchors = false) => {
      const inputProps = {art: name, data: d, events, showAnchors};
      const composition = await selectComposition({serveUrl, id: 'ArtProbe', inputProps});
      let geo: any = null;
      const file = join(OUT, `${name}__${tag}.png`);
      await still({serveUrl, composition, inputProps, output: file, frame, onLog: (t) => t.startsWith('[probe] ') && (geo = JSON.parse(t.slice(8)))});
      return {img: await Jimp.read(file), geo, file};
    };
    let base: Awaited<ReturnType<typeof shot>>;
    try {
      base = await shot('settled', T.settled);
    } catch (e) {
      problems.push(`does not render: ${(e as Error).message.split('\n')[0]}`);
      report(name, problems, notes);
      failed++;
      continue;
    }
    const g = base.geo;
    const box: Box = {x: g.x, y: g.y, w: g.w * g.k, h: g.h * g.k};
    // anchors: same names in renderer and catalogue, all on the drawing
    const drawn = Object.keys(g.anchors);
    if (entry) {
      const listed = entry.anchors(d);
      const missing = listed.filter((a: string) => !drawn.includes(a));
      const extra = drawn.filter((a) => !listed.includes(a));
      if (missing.length) problems.push(`catalogue anchors not in the art: ${missing.join(', ')}`);
      if (extra.length) problems.push(`art anchors not in the catalogue: ${extra.join(', ')}`);
      for (const e of entry.events ?? []) if (!drawn.includes(e)) problems.push(`event "${e}" is not an anchor of the art`);
    }
    for (const [a, [x, y]] of Object.entries(g.anchors) as [string, [number, number]][]) if (x < 0 || y < 0 || x > g.w || y > g.h) problems.push(`anchor "${a}" lies outside the drawing`);
    // the drawing itself
    const m = measure(base.img, box);
    if (m.ink < LIMITS.minInk || !m.bbox) problems.push(`almost nothing is drawn (${(m.ink * 100).toFixed(1)}% ink)`);
    else {
      // a speck in a corner fails; a tall narrow object (a bottle) that spans its height is fine
      const span = Math.max(m.bbox.w / box.w, m.bbox.h / box.h);
      if (span < LIMITS.minSpan) problems.push(`the drawing spans only ${Math.round(span * 100)}% of its box — size the art's w×h to the drawing`);
      notes.push(`ink ${(m.ink * 100).toFixed(0)}% · span ${Math.round(span * 100)}%`);
    }
    const edge = edgeInk(base.img, box);
    if (edge > LIMITS.maxEdge) problems.push(`the drawing runs into its box edges (${Math.round(edge * 100)}% of the border) — it will look cut off; add margin`);
    if (m.colour < LIMITS.minColour) problems.push(`mostly grey/black (${Math.round(m.colour * 100)}% colourful) — house style is colourful flat forms outlined in a darker shade of their hue`);
    const start = await shot('start', 2);
    if (measure(start.img, box).ink > LIMITS.drawOn * m.ink) problems.push('does not draw on (the picture is complete at the first frames) — use draw()/fillIn() or Form');
    const again = await shot('again', T.settled);
    if (changed(base.img, again.img, box) > 0) problems.push('not deterministic (the same frame renders differently) — no Math.random/Date; animate from f');
    // events
    const tiles = [start.file, base.file];
    const legend = ['1 first frames (drawing on)', '2 settled, no events'];
    for (const e of entry?.events ?? []) {
      // brief events (a puff, a flash) count too: visible at ANY of several moments after firing
      let ev = await shot(`event-${e}`, T.settled, {[e]: T.eventAt});
      let best = changed(base.img, ev.img, box);
      for (const dt of [15, 45]) {
        const early = await shot(`event-${e}-${dt}`, T.eventAt + dt, {[e]: T.eventAt});
        const ref = await shot(`base-${dt}`, T.eventAt + dt);
        const d = changed(ref.img, early.img, box);
        if (d > best) (best = d), (ev = early);
      }
      // visible either across the picture or where it happens (a face changing expression is
      // small overall but obvious when the camera pushes in on the named part)
      const [ax, ay] = g.anchors[e] ?? [g.w / 2, g.h / 2];
      const r = Math.max(box.w, box.h) * 0.14;
      const near = {x: Math.max(box.x, g.x + ax * g.k - r), y: Math.max(box.y, g.y + ay * g.k - r), w: 2 * r, h: 2 * r};
      const diff = Math.max(best, changed(base.img, ev.img, near) / 3);
      if (diff < LIMITS.minEvent) problems.push(`event "${e}" changes almost nothing (${(diff * 100).toFixed(2)}%), neither overall nor at its anchor — make it visible`);
      notes.push(`${e} ${(diff * 100).toFixed(1)}%`);
      tiles.push(ev.file);
      legend.push(`${tiles.length} after event "${e}"`);
      const late = await shot(`event-${e}-late`, T.late, {[e]: T.eventAt});
      tiles.push(late.file);
      legend.push(`${tiles.length} "${e}" later (ongoing motion)`);
    }
    const anchors = await shot('anchors', T.settled, {}, true);
    tiles.push(anchors.file);
    legend.push(`${tiles.length} anchors (where labels and the camera land)`);
    // gallery: tiles in reading order, 3 per row, with a legend file for the reviewer
    const cols = 3;
    const rows = Math.ceil(tiles.length / cols);
    const W = 600;
    const H = 450;
    const sheet = new Jimp({width: W * cols, height: H * rows, color: 0xeeeeeeff});
    for (let i = 0; i < tiles.length; i++) {
      const t = await Jimp.read(tiles[i]);
      t.resize({w: W - 8, h: H - 8});
      sheet.composite(t, (i % cols) * W + 4, Math.floor(i / cols) * H + 4);
    }
    const gallery = join(OUT, `${name}.png`) as `${string}.png`;
    await sheet.write(gallery);
    writeFileSync(join(OUT, `${name}.txt`), [`${name}: ${entry?.doc ?? ''}`, `events: ${(entry?.events ?? []).join(', ') || '—'}`, 'tiles (left→right, top→bottom):', ...legend].join('\n') + '\n');
    notes.push(`gallery ${gallery.replace(ROOT + '/', '')}`);
    report(name, problems, notes);
    if (problems.length) failed++;
  }
  await closeBrowser();
  return failed;
}
/**
 * A draft pack enters the library: its gates passed on the current code AND the art-reviewer's
 * verdict (iterations/artlab/<pack>.review.json: {"pack", "verdicts": {art: "PASS" | "FIX: …"}})
 * passes every art. Renames <pack>.catalog.draft.ts → .catalog.ts and regenerates the registries.
 */
async function approve(pack: string) {
  const draft = join(PACKS, `${pack}.catalog.draft.ts`);
  if (!existsSync(draft)) return console.log(`no draft pack "${pack}"`), false;
  const arts = Object.keys((await import(`../src/art/packs/${pack}.catalog.draft.ts`)).default);
  const failed = await check(arts, undefined, pack);
  if (failed) return console.log(`❌ ${pack}: gates fail — not approved`), false;
  const rf = join(OUT, `${pack}.review.json`);
  const review = existsSync(rf) ? JSON.parse(readFileSync(rf, 'utf8')) : null;
  // a verdict only counts for the drawing it saw: the review must be newer than the pack's files
  const changedAt = Math.max(statSync(join(PACKS, `${pack}.tsx`)).mtimeMs, statSync(draft).mtimeMs);
  if (review && statSync(rf).mtimeMs < changedAt) return console.log(`❌ ${pack}: the art changed after the review — run the art-reviewer again`), false;
  const bad = arts.filter((a) => !/^PASS/.test(review?.verdicts?.[a] ?? ''));
  if (bad.length) return console.log(`❌ ${pack}: no reviewer PASS for ${bad.join(', ')} (${rf.replace(ROOT + '/', '')})`), false;
  renameSync(draft, join(PACKS, `${pack}.catalog.ts`));
  register();
  console.log(`✅ ${pack} approved: ${arts.join(', ')} are in the library`);
  return true;
}

const report = (name: string, problems: string[], notes: string[]) => {
  console.log(`${problems.length ? '❌' : '✅'} ${name}  ${notes.join(' · ')}`);
  for (const p of problems) console.log(`   ✗ ${p}`);
};

if (import.meta.filename === process.argv[1]) {
  const argv = process.argv.slice(2);
  const flag = (k: string) => (argv.includes(`--${k}`) ? argv[argv.indexOf(`--${k}`) + 1] : undefined);
  const flags = {pack: flag('pack'), data: flag('data')};
  const [cmd, ...rest] = argv.filter((a, i) => !a.startsWith('--') && !['--pack', '--data'].includes(argv[i - 1]));
  if (cmd === 'register') console.log(`registered generated packs: ${register().join(', ') || '(none)'}`);
  else if (cmd === 'gaps') process.exit((await gaps(rest[0])).length ? 1 : 0);
  else if (cmd === 'approve') process.exit(await approve(rest[0]) ? 0 : 1);
  else if (cmd === 'check') {
    register();
    let names = rest;
    const pack = flags.pack;
    const isDraft = !!pack && existsSync(join(PACKS, `${pack}.catalog.draft.ts`));
    if (pack) names = Object.keys((await import(`../src/art/packs/${pack}.catalog${isDraft ? '.draft' : ''}.ts`)).default);
    const failed = await check(names, typeof flags.data === 'string' ? JSON.parse(flags.data) : undefined, isDraft ? pack : undefined);
    if (pack) writeFileSync(join(OUT, `${pack}.gates.json`), JSON.stringify({pack, arts: names, pass: failed === 0, at: new Date().toISOString()}, null, 1));
    console.log(failed ? `\n❌ ${failed}/${names.length} art(s) failed the gates` : `\n✅ ${names.length} art(s) pass the gates — now the art-reviewer judges the galleries`);
    process.exit(failed ? 1 : 0);
  } else console.log(readFileSync(new URL(import.meta.url), 'utf8').split('*/')[0]);
}
