/**
 * The playbook store for drawn (code) art: assets/playbooks/<artKey>.json = {art, playbooks: […]},
 * compiled into src/art/playbooks.gen.ts so drawn art teaches exactly like imported art (whose
 * playbooks live in its manifest). Written once per art by the visuals stage (Opus), reused forever.
 */
import {existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {ROOT} from './paths.mts';

const DIR = join(ROOT, 'assets', 'playbooks');
export function savePlaybooks(art: string, playbooks: any[]) {
  mkdirSync(DIR, {recursive: true});
  writeFileSync(join(DIR, `${art}.json`), JSON.stringify({art, playbooks}, null, 2) + '\n');
  writePlaybookRegistry();
}
export function writePlaybookRegistry() {
  const all = existsSync(DIR) ? readdirSync(DIR).filter((f) => f.endsWith('.json')).map((f) => JSON.parse(readFileSync(join(DIR, f), 'utf8'))) : [];
  writeFileSync(
    join(ROOT, 'src', 'art', 'playbooks.gen.ts'),
    `// generated by scripts/lib/playbook-store.mts from assets/playbooks/ — do not edit\nexport const DRAWN_PLAYBOOKS: Record<string, any[]> = ${JSON.stringify(Object.fromEntries(all.map((x) => [x.art, x.playbooks])), null, 1)};\n`,
  );
}
