/**
 * Regenerates src/registry.gen.ts: every voiced lesson of every project, so Remotion Studio
 * can browse them. Studio only — renders pass their props directly (scripts/lib/remotion.mts).
 * Run automatically by voiceover.mts.
 */
import {existsSync, writeFileSync} from 'node:fs';
import {join, relative} from 'node:path';
import {fileURLToPath} from 'node:url';
import {ROOT, listProjects, specIds, specPath, timingsPath} from './lib/paths.mts';

export function writeRegistry() {
  const rel = (p: string) => './' + relative(join(ROOT, 'src'), p).replace(/\\/g, '/');
  const ready = listProjects().flatMap((p) => specIds(p).filter((id) => existsSync(timingsPath(p, id))).map((id) => ({p, id})));
  const v = (p: string, id: string) => `${p.replace(/\W/g, '_')}_${id}`;
  const projects = [...new Set(ready.map((r) => r.p))];
  const pv = (p: string) => `p_${p.replace(/\W/g, '_')}`;
  const out = `// AUTO-GENERATED by scripts/prepare-registry.mts — do not edit by hand.
import type {VideoProps} from './VideoComposition';
import {withDefaults} from './project';
${projects.map((p) => `import ${pv(p)} from '${rel(join(ROOT, 'projects', p, 'project.json'))}';`).join('\n')}
${ready.map(({p, id}) => `import s_${v(p, id)} from '${rel(specPath(p, id))}';\nimport t_${v(p, id)} from '${rel(timingsPath(p, id))}';`).join('\n')}

export const READY: VideoProps[] = [
${ready.map(({p, id}) => `  {project: withDefaults('${p}', ${pv(p)} as never), spec: s_${v(p, id)} as VideoProps['spec'], timings: t_${v(p, id)} as VideoProps['timings']}`).join(',\n')}
];
`;
  writeFileSync(join(ROOT, 'src', 'registry.gen.ts'), out);
  return ready.length;
}

if (fileURLToPath(import.meta.url) === process.argv[1]) console.log(`Registered ${writeRegistry()} lesson(s) for Studio.`);
