    {
      "id": "flexibleEndoscope.anatomy",
      "teaches": "The parts of a flexible endoscope, part by part, so later reprocessing steps can be located on it (an opener or 'what the device is made of' scene).",
      "moments": [
        {"slot": "whole", "hint": ["flexible endoscope", "endoscope", "device", "parts"], "beat": {"camera": "overview", "label": {"on": "controlBody", "text": "Flexible endoscope"}}},
        {"slot": "controlBody", "hint": ["control body", "handle", "control section", "valves", "buttons"], "beat": {"act": "controlBodyRegion", "camera": {"on": "controlBody", "zoom": 1.5}, "label": [{"on": "controlBody", "text": "Control body"}, {"on": "eyepiece", "text": "Eyepiece"}]}},
        {"slot": "port", "hint": ["port", "instrument", "biopsy", "channel opening"], "beat": {"pulse": "instrumentChannelPort", "label": {"on": "instrumentChannelPort", "text": "Instrument channel port"}}, "optional": true},
        {"slot": "insertionTube", "hint": ["insertion tube", "insertion", "shaft", "tube"], "beat": {"act": "insertionTubeRegion", "camera": "overview", "label": {"on": "insertionTube", "text": "Insertion tube"}}},
        {"slot": "distalTip", "hint": ["distal tip", "distal end", "bending section", "tip"], "beat": {"act": "distalTipRegion", "camera": {"on": "distalTip", "zoom": 1.6}, "label": [{"on": "distalTip", "text": "Distal tip"}, {"on": "bendingSection", "text": "Bending section"}]}},
        {"slot": "umbilical", "hint": ["umbilical", "universal cord", "light guide", "connector"], "beat": {"act": "connectorRegion", "camera": "overview", "label": [{"on": "umbilicalCord", "text": "Umbilical cord"}, {"on": "lightGuideConnector", "text": "Light guide connector"}]}}
      ]
    },
    {
      "id": "flexibleEndoscope.channelPath",
      "teaches": "The path a channel follows through the endoscope, from the port on the control body down the insertion tube to the opening at the distal tip, as when brushing or flushing a channel.",
      "moments": [
        {"slot": "entry", "hint": ["port", "opening", "inlet", "channel", "brush"], "beat": {"camera": {"on": "instrumentChannelPort", "zoom": 1.6}, "pulse": "instrumentChannelPort", "label": {"on": "instrumentChannelPort", "text": "Instrument channel port"}}},
        {"slot": "through", "hint": ["through", "length", "insertion tube", "along", "inside"], "beat": {"act": "insertionTubeRegion", "camera": "overview", "label": {"on": "insertionTube", "text": "Channel runs inside"}}},
        {"slot": "exit", "hint": ["distal", "tip", "exits", "emerges", "outlet"], "beat": {"act": "distalTipRegion", "camera": {"on": "distalTip", "zoom": 1.6}, "label": {"on": "distalTip", "text": "Distal tip"}}},
        {"slot": "back", "hint": ["whole", "entire", "every channel", "full length"], "beat": {"camera": "overview", "pulse": "lightGuideConnector"}, "optional": true}
      ]
    },
    {
      "id": "flexibleEndoscope.reprocessingPoints",
      "teaches": "Where the reprocessing steps act on the device: wiping the insertion tube, cleaning the distal tip, the control body, and the connector end that must be capped or connected.",
      "moments": [
        {"slot": "wipe", "hint": ["wipe", "pre-clean", "bedside", "insertion tube", "outer surface"], "beat": {"act": "insertionTubeRegion", "label": {"on": "insertionTube", "text": "Wipe insertion tube"}}},
        {"slot": "tip", "hint": ["distal tip", "tip", "lens", "brush"], "beat": {"camera": {"on": "distalTip", "zoom": 1.6}, "act": "distalTipRegion", "label": {"on": "distalTip", "text": "Distal tip"}}, "optional": true},
        {"slot": "controls", "hint": ["control body", "valves", "buttons", "remove", "ports"], "beat": {"camera": {"on": "controlBody", "zoom": 1.5}, "act": "controlBodyRegion", "label": {"on": "controlBody", "text": "Control body"}}},
        {"slot": "connector", "hint": ["connector", "cap", "light guide", "connections", "leak test"], "beat": {"camera": {"on": "lightGuideConnector", "zoom": 1.5}, "act": "connectorRegion", "label": [{"on": "lightGuideConnector", "text": "Light guide connector"}, {"on": "connectorPort", "text": "Connector port"}]}},
        {"slot": "overview", "hint": ["whole", "every part", "complete", "entire endoscope"], "beat": {"camera": "overview", "label": {"on": "umbilicalCord", "text": "Umbilical cord"}}}
      ]
    }
