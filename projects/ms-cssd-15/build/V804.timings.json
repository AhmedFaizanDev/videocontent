    {
      "index": 9,
      "type": "answer",
      "narration": "Because residual moisture lets Pseudomonas and other Gram-negative organisms multiply between uses, so a correctly disinfected scope becomes contaminated in storage. A coiled scope holds fluid. Hanging vertically and uncoiled, with valves removed, lets every channel drain and dry.",
      "audioFile": "audio/vo/ms-cssd-15/V804/scene-9.mp3",
      "voDurationInSeconds": 19.896,
      "voDurationInFrames": 597,
      "leadFrames": 26,
      "tailFrames": 44,
      "durationInFrames": 667,
      "startFrame": 4666,
      "captions": [
