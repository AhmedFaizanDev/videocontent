        {
          "text": "where the protocol specifies, followed by",
          "start": 2.706,
          "end": 5.206
        },
        {
          "text": "forced air through every channel.",
          "start": 5.206,
          "end": 7.173
        },
        {
          "text": "Residual moisture lets waterborne",
          "start": 7.849,
          "end": 9.832
        },
        {
          "text": "organisms, especially Pseudomonas,",
          "start": 9.832,
          "end": 12.543999999999999
        },
        {
          "text": "multiply between uses.",
          "start": 12.584,
          "end": 14.359
        },
        {
          "text": "A coiled scope retains fluid.",
          "start": 15.06,
          "end": 17.159
        },
        {
          "text": "So store it hanging vertically, uncoiled,",
          "start": 17.873,
          "end": 20.721
        },
        {
          "text": "valves removed, in a controlled drying",
          "start": 20.721,
          "end": 23.137
