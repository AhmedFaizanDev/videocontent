          "start": 0.098,
          "end": 2.365
        },
        {
          "text": "Immerse the scope fully in the correct",
          "start": 3.077,
          "end": 4.856
        },
        {
          "text": "detergent, at the correct dilution and",
          "start": 4.856,
          "end": 7.199
        },
        {
          "text": "temperature. Wipe the exterior and",
          "start": 7.199,
          "end": 10.012
        },
        {
          "text": "insertion tube. Brush every channel, with",
          "start": 10.012,
          "end": 13.51
        },
        {
          "text": "the right brush for that model, until it",
          "start": 13.51,
          "end": 15.829
        },
        {
          "text": "comes out visibly clean.",
          "start": 15.829,
          "end": 17.616
        },
        {
          "text": "Then brush the ports, valves and elevator",
          "start": 18.293,
          "end": 20.913
        },
        {
          "text": "recess.",
          "start": 20.913,
          "end": 21.63
        }
