    {
      "index": 4,
      "type": "figure",
      "narration": "Why is brushing irreplaceable? Biofilm is organisms embedded in a protective matrix on the channel wall. Disinfectant can't penetrate it. Soaking and flushing flow straight over it. Only a brush, physically contacting the wall, breaks it up. That's why brush diameter matters.",
      "audioFile": "audio/vo/ms-cssd-15/V803/scene-4.mp3",
      "voDurationInSeconds": 21.672,
      "voDurationInFrames": 651,
      "leadFrames": 26,
      "tailFrames": 44,
      "durationInFrames": 721,
      "startFrame": 2059,
      "captions": [
        {
          "text": "Why is brushing irreplaceable?",
          "start": 0.098,
          "end": 2.089
        },
        {
          "text": "Biofilm is organisms embedded in a",
          "start": 2.788,
          "end": 5.012
        },
        {
          "text": "protective matrix on the channel wall.",
          "start": 5.012,
          "end": 7.412
        },
        {
          "text": "Disinfectant can't penetrate it.",
          "start": 8.089,
          "end": 10.223999999999998
        },
        {
          "text": "Soaking and flushing flow straight over",
          "start": 10.925,
          "end": 12.945
        },
        {
          "text": "it. Only a brush, physically contacting",
          "start": 12.945,
          "end": 16.322
        },
        {
          "text": "the wall, breaks it up.",
          "start": 16.322,
          "end": 18.025
        },
        {
          "text": "That's why brush diameter matters!",
          "start": 18.738,
          "end": 21.005
        }
      ],
