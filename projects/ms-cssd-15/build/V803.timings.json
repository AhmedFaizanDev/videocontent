    {
      "index": 2,
      "type": "steps",
      "narration": "Manual cleaning follows seven steps. Immerse the scope fully in the correct detergent, at the correct dilution and temperature. Wipe the exterior and insertion tube. Brush every channel, with the right brush for that model, until it comes out visibly clean. Then brush the ports, valves and elevator recess.",
      "audioFile": "audio/vo/ms-cssd-15/V803/scene-2.mp3",
      "voDurationInSeconds": 22.344,
      "voDurationInFrames": 671,
      "leadFrames": 26,
      "tailFrames": 44,
      "durationInFrames": 741,
      "startFrame": 722,
      "captions": [
        {
