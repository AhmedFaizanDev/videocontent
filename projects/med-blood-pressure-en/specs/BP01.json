        "w": 2600,
        "h": 1200,
        "layers": [
          {
            "id": "heart",
            "art": "heart",
            "at": [
              560,
              620
            ],
            "h": 760
          },
          {
            "id": "artery",
            "art": "vessel",
            "at": [
              1840,
              600
            ],
            "h": 980
          }
        ]
      },
      "beats": [
        {
          "say": [
            "force"
          ],
          "note": "Blood pressure: the force of blood on artery walls"
        },
        {
          "say": [
            "inside"
          ],
          "camera": {
            "on": "artery"
          },
          "label": {
            "on": "artery.wall",
            "text": "Artery wall"
          }
        },
        {
          "say": [
            "heartbeat"
          ],
          "camera": "overview",
          "travel": {
            "along": [
              "heart.lv",
              "artery.lumen"
